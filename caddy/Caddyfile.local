# Local development Caddyfile
# Uses self-signed certificates for HTTPS locally

{
    # Disable automatic HTTPS for local development
    auto_https disable_redirects
    local_certs
}

# Main site (localhost)
localhost {
    tls internal

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; connect-src 'self' wss: https://stats.localhost; script-src 'self' https://stats.localhost; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
    }

    # API routes
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Static assets with caching
    @static path *.ico *.webp *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf *.eot
    handle @static {
        header Cache-Control "public, max-age=31536000, no-transform"
        reverse_proxy frontend:80
    }

    # Default: serve frontend
    reverse_proxy frontend:80
}

# GoatCounter subdomain (stats.localhost)
stats.localhost {
    tls internal

    header {
        Access-Control-Allow-Origin "https://localhost"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type"
    }

    @options method OPTIONS
    handle @options {
        header Content-Length "0"
        respond 204
    }

    reverse_proxy goatcounter:8080
}
