# Production Caddyfile
# Caddy automatically obtains and renews SSL certificates from Let's Encrypt

{
    email {$CADDY_EMAIL}
}

# Redirect www to non-www
www.{$CADDY_DOMAIN} {
    redir https://{$CADDY_DOMAIN}{uri} permanent
}

# Main site
{$CADDY_DOMAIN} {
    encode zstd gzip
    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; connect-src 'self' wss: https://stats.{$CADDY_DOMAIN}; script-src 'self' https://stats.{$CADDY_DOMAIN}; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
    }

    handle /api/* {
        reverse_proxy backend:8000 {
            header_down -Server
        }
    }

    # Static assets with caching
    @static path *.ico *.webp *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf *.eot
    handle @static {
        header Cache-Control "public, max-age=31536000, no-transform"
        reverse_proxy frontend:80 {
            header_down -Server
        }
    }

    reverse_proxy frontend:80 {
        header_down -Server
    }
}

# GoatCounter subdomain
stats.{$CADDY_DOMAIN} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Access-Control-Allow-Origin "https://{$CADDY_DOMAIN}"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type"
    }

    @options method OPTIONS
    handle @options {
        header Content-Length "0"
        respond 204
    }

    reverse_proxy goatcounter:8080 {
        header_down -Server
    }
}
