{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CV Content Configuration",
  "description": "Schema for content.yaml used as single source of truth by the Hugo frontend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "experience",
    "projects",
    "skills",
    "education",
    "certifications",
    "about",
    "contact"
  ],
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "tagline",
        "description",
        "url",
        "github",
        "linkedin",
        "keywords",
        "image",
        "copyright_year",
        "hosting"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "github": { "type": "string", "format": "uri" },
        "linkedin": { "type": "string", "format": "uri" },
        "keywords": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "copyright_year": { "type": "integer", "minimum": 2020 },
        "hosting": { "type": "string", "minLength": 1 }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "company",
          "location",
          "logo",
          "start_date",
          "end_date",
          "highlights"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "company": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "logo": { "type": "string", "minLength": 1 },
          "start_date": { "type": "string", "minLength": 1 },
          "end_date": { "type": "string", "minLength": 1 },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "icon",
          "icon_color",
          "github",
          "description",
          "tags"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 },
          "icon_color": { "type": "string", "minLength": 1 },
          "github": { "type": ["string", "null"], "format": "uri" },
          "description": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filters", "categories"],
      "properties": {
        "filters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "filter", "items"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "filter": { "type": "string", "minLength": 1 },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["degree", "school", "location", "logo", "years"],
        "properties": {
          "degree": { "type": "string", "minLength": 1 },
          "school": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "logo": { "type": "string", "minLength": 1 },
          "years": { "type": "string", "minLength": 1 }
        }
      }
    },
    "certifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "issuer", "date", "icon", "link", "courses"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 },
          "icon_type": { "type": "string", "enum": ["image"] },
          "link": { "type": ["string", "null"], "format": "uri" },
          "courses": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "icon", "text"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "icon": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 }
      }
    }
  }
}
